<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/main.uss?fileID=7433441132597879392&amp;guid=794ff835ba686f449b35e9edcf0ec18e&amp;type=3#main" />
    <ui:VisualElement name="MainZone" style="flex-grow: 1; flex-direction: row; background-color: rgb(209, 222, 255);">
        <ui:VisualElement name="MenuZone" style="flex-grow: 0; width: 60%;">
            <ui:VisualElement name="MenuSabor" style="flex-grow: 1;">
                <ui:Slider label="R" high-value="255" name="SliderR" style="background-color: rgba(255, 0, 0, 0.3);" />
                <ui:Slider label="G" high-value="255" name="SliderG" style="background-color: rgba(0, 255, 0, 0.38);" />
                <ui:Slider label="B" high-value="255" name="SliderB" focusable="false" style="background-color: rgba(0, 0, 255, 0.35); justify-content: space-around;" />
            </ui:VisualElement>
            <ui:VisualElement name="MenuDeco1" style="flex-grow: 1;">
                <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="ScrollView" style="flex-grow: 0;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-self: flex-start;">
                        <ui:VisualElement style="flex-grow: 1; align-self: flex-start; background-image: resource(&apos;Images/gato&apos;); width: 50px; height: 100px;" />
                        <ui:VisualElement style="flex-grow: 1; align-self: flex-start; background-image: resource(&apos;Images/gato&apos;); width: 50px; height: 100px;" />
                        <ui:VisualElement style="flex-grow: 1; align-self: flex-start; background-image: resource(&apos;Images/gato&apos;); width: 50px; height: 100px;" />
                        <ui:VisualElement style="flex-grow: 1; align-self: flex-start; background-image: resource(&apos;Images/gato&apos;); width: 50px; height: 100px;" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="MenuDeco2" style="flex-grow: 1;" />
            <ui:VisualElement name="MenuEtiqueta" style="flex-grow: 1; flex-direction: row;">
                <ui:DropdownField label="Dropdown" />
                <ui:TextField picking-mode="Ignore" label="Text Field" value="filler text" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CakeZone" style="flex-grow: 1; flex-direction: column-reverse; flex-wrap: nowrap;">
            <ui:VisualElement name="CakeFull" style="flex-grow: 1; flex-direction: column; height: 80%; background-image: resource(&apos;Images/tarta&apos;); width: 100%; -unity-background-scale-mode: scale-to-fit; justify-content: flex-start; align-items: flex-start; align-self: flex-start;">
                <ui:VisualElement name="CakeCandle" class="tarta" style="width: 100%; flex-grow: 0; height: 20%;" />
                <ui:VisualElement name="CakeTop" class="tarta" style="width: 44%; flex-grow: 0; height: 20%; align-self: center;" />
                <ui:VisualElement name="CakeMid" class="tarta" style="flex-grow: 0; width: 63%; height: 26%; align-self: center;" />
                <ui:VisualElement name="CakeBottom" class="tarta" style="flex-grow: 0; width: 93%; height: 34%; align-self: center;">
                    <ui:VisualElement name="CakeTaste" style="flex-grow: 0; flex-direction: column; height: 100%; background-image: none; width: 25%; -unity-background-scale-mode: scale-to-fit; justify-content: flex-start; align-items: flex-start; align-self: flex-start; left: 6%; background-color: rgba(0, 0, 0, 0.58);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="Guardar sabor" parse-escape-sequences="true" display-tooltip-when-elided="true" style="flex-grow: 1;" />
            <ui:Label tabindex="-1" text="Etiqueta" parse-escape-sequences="true" display-tooltip-when-elided="true" style="flex-grow: 1;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
